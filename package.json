{
  "name": "qireader-desktop",
  "productName": "QiReader Desktop",
  "version": "0.6.1",
  "private": true,
  "description": "QiReader and original articles in one desktop window",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/policy.test.cjs test/reading-progress.test.cjs",
    "test:browser": "node test/run-smoke.cjs",
    "package:win": "electron-packager . QiReader-Desktop --platform=win32 --arch=x64 --out=dist --asar --ignore=\"^/(dist|test|artifacts|\\.git|\\.github)(/|$)|^/VALIDATION\\.md$\""
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0"
  }
}
